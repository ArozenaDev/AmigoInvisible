# Valores de referencia: sustituirlos en .env local y en las variables privadas de Vercel.
# No usar contraseñas reales ni hashes de producción en este archivo.
ADMIN_USERNAME=replace-with-private-admin-username
ADMIN_PASSWORD_HASH=replace-with-a-secure-password-hash-generated-outside-the-repository
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# PostgreSQL is required when deployed; configure this as a server-side secret.
# DATABASE_URL=replace-with-a-private-pooled-postgresql-connection-string
# Optional for testing PostgreSQL locally instead of the default local JSON:
# STORAGE_BACKEND=postgres
